---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Profile' },
  { href: '/card/', label: 'Contact' },
  { href: '/research/', label: 'Research' },
  { href: '/projects/', label: 'Projects' }
];
---

<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header">
  <nav class="nav shell" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="Murilo Lopes — home">
      <img src="/icons/szero-mark.svg" alt="" width="34" height="34" />
      <span>Murilo Lopes</span>
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
