---
import MainLayout from '../../layouts/MainLayout.astro';
import { publications, researchAreas } from '../../data/publications';
---

<MainLayout title="Research — Murilo Luz" description="Research themes and publications by Murilo Luz in AI, decision systems, software architecture and health interoperability.">
  <header class="page-intro">
    <div class="shell">
      <p class="kicker">Research / Current questions</p>
      <h1>Better decisions require better learning loops.</h1>
      <p class="lead">Research focused on systems that decide, act, evaluate and improve under real constraints.</p>
    </div>
  </header>
  <section class="section dark" aria-labelledby="areas-title">
    <div class="shell">
      <div class="section-head"><p class="kicker">Areas</p><h2 id="areas-title">What I am investigating.</h2></div>
      <div class="grid">
        {researchAreas.map((area, index) => (
          <article class="card"><span class="index label">{String(index + 1).padStart(2, '0')}</span><h3>{area}</h3></article>
        ))}
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="publications-title">
    <div class="shell">
      <div class="section-head"><p class="kicker">Publications</p><h2 id="publications-title">Selected writing and papers.</h2></div>
      {publications.length > 0 ? (
        <div class="grid">
          {publications.map((publication) => (
            <a class="card" href={publication.href ?? '#'}><span class="index label">{publication.year}</span><h3>{publication.title}</h3><p>{publication.venue}</p></a>
          ))}
        </div>
      ) : <p class="empty-state">Publication list is being curated. Add entries in <code>src/data/publications.ts</code>.</p>}
    </div>
  </section>
</MainLayout>
