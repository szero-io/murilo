---
interface Props {
  project: {
    title: string;
    description: string;
    tags: readonly string[];
    href: string;
  };
  index: number;
}

const { project, index } = Astro.props;
---

<a class="card" href={project.href} target="_blank" rel="noopener noreferrer">
  <span class="index label">{String(index + 1).padStart(2, '0')}</span>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <ul class="tags" aria-label="Technologies">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
</a>
