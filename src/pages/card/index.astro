---
import MainLayout from '../../layouts/MainLayout.astro';
import { contacts, profile } from '../../data/profile';
import sharp from 'sharp';
import { fileURLToPath } from 'node:url';

const photoPath = fileURLToPath(new URL('../../../public/images/murilo.webp', import.meta.url));
const photo = await sharp(photoPath)
  .resize(512, 512, { fit: 'cover', position: 'attention' })
  .jpeg({ quality: 82 })
  .toBuffer();
const photoLine = `PHOTO;ENCODING=b;TYPE=JPEG:${photo.toString('base64')}`
  .match(/.{1,74}/g)
  ?.join('\r\n ') ?? '';

const vcard = [
  'BEGIN:VCARD',
  'VERSION:3.0',
  `N:${profile.familyName};${profile.givenName};;;`,
  `FN:${profile.name}`,
  `ORG:${profile.company}`,
  `TITLE:${profile.role}`,
  `item1.EMAIL;TYPE=INTERNET:${profile.emailSzero}`,
  'item1.X-ABLabel:Szero',
  `item2.EMAIL;TYPE=INTERNET:${profile.emailCeia}`,
  'item2.X-ABLabel:CEIA',
  `TEL;TYPE=CELL:${profile.phone}`,
  `URL:${profile.site}`,
  `X-SOCIALPROFILE;TYPE=linkedin:${profile.linkedin}`,
  `X-SOCIALPROFILE;TYPE=instagram:${profile.instagram}`,
  `X-SOCIALPROFILE;TYPE=github:${profile.github}`,
  photoLine,
  'END:VCARD'
].join('\r\n');
---

<MainLayout title="Murilo Luz — Contact" description={`Contact card for ${profile.name}, ${profile.role}.`} hideChrome>
  <section class="profile-card">
    <div class="profile-image">
      <img src={profile.image} width="640" height="800" alt={profile.name} fetchpriority="high" />
    </div>
    <div class="profile-content">
      <a href="/" aria-label="Back to home"><img class="brand-mark" src="/icons/szero-mark.svg" width="48" height="48" alt="" /></a>
      <h1>{profile.name}</h1>
      <p class="profile-role">{profile.role}</p>
      <p class="lead">{profile.shortIntro}</p>
      <ul class="profile-links">
        {contacts.map((contact) => (
          <li><a href={contact.href} target={contact.href.startsWith('http') ? '_blank' : undefined} rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}><span class="profile-link-copy"><span class="label">{contact.label}</span><span class="value">{contact.value}</span></span><span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
      <div class="profile-actions">
        <button class="button" id="save-contact" type="button" data-vcard={encodeURIComponent(vcard)}>Save contact</button>
        <a class="button secondary" href="/">Full profile</a>
      </div>
    </div>
  </section>
  <script>
    const button = document.querySelector<HTMLButtonElement>('#save-contact');
    button?.addEventListener('click', () => {
      const content = decodeURIComponent(button.dataset.vcard ?? '');
      const blob = new Blob([content], { type: 'text/vcard;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'murilo-luz.vcf';
      link.click();
      URL.revokeObjectURL(url);
    });
  </script>
</MainLayout>
