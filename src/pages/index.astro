---
import MainLayout from '../layouts/MainLayout.astro';
import ContactList from '../components/ContactList.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
---

<MainLayout title="Murilo Luz — Head de TI do CEIA & Founder da Szero" description={profile.intro}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker">Head de TI do CEIA · Founder da Szero</p>
        <h1>Technology with direction.</h1>
        <p class="lead">{profile.intro}</p>
        <div class="hero-actions">
          <a class="button" href="/card/">Contact me</a>
          <a class="button secondary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
      <figure class="hero-portrait">
        <img src={profile.image} width="640" height="800" alt={profile.name} fetchpriority="high" />
        <figcaption><span>{profile.name}</span><span>CEIA · Szero</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="shell">
      <div class="section-head">
        <p class="kicker">Contact</p>
        <div><h2 id="contact-title">Let’s start a conversation.</h2><p class="lead">The fastest path is LinkedIn. For Szero work, email is open too.</p></div>
      </div>
      <ContactList />
    </div>
  </section>

  <section class="section dark" aria-labelledby="experience-title">
    <div class="shell">
      <div class="section-head">
        <p class="kicker">Leadership</p>
        <div><h2 id="experience-title">Where I am building now.</h2></div>
      </div>
      <div class="grid">
        {experience.map((item, index) => (
          <article class="card">
            <span class="index label">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.organization}</h3>
            <p><strong>{item.role}</strong></p>
            <p>{item.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
